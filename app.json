{
  "expo": {
    "name": "StepPool",
    "slug": "steppool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "steppool",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.steppool.app",
      "associatedDomains": [
        "applinks:steppool.onrender.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.steppool.app"
        ]
      },
      "appleTeamId": "LVQVXJXD2Z",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.steppool.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "steppool.onrender.com",
              "pathPrefix": "/j/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#07080A"
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "StepPool reads your steps to verify your progress in challenges.",
          "NSHealthUpdateUsageDescription": false,
          "background": true
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "color": "#D7FF3A"
        }
      ],
      "expo-font",
      "@bacons/apple-targets",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07080A"
  }
}
