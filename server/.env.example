PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/steppool?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
ADMIN_API_KEY=change-me
PUBLIC_URL=https://steppool.onrender.com
# Gmail account + app password for emailing sign-in codes. Unset in dev: codes come back in the response.
MAIL_USER=
MAIL_APP_PASSWORD=
# Comma-separated extra trusted step sources (bundle ids / package names).
EXTRA_TRUSTED_SOURCES=
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=
# Sign in with Apple: identity-token audience = iOS bundle id.
APPLE_AUDIENCES=com.steppool.app
# Google OAuth client ids (iOS + Android/web), comma-separated.
GOOGLE_CLIENT_IDS=
