# ~/steppool/.env on the server. Copy values from the Render dashboard (steppool-api > Environment).
# JWT_SECRET must match Render's exactly, or every signed-in user is logged out.
PUBLIC_URL=https://steppool.mytrofficient.com
MONGO_URL=
JWT_SECRET=
ADMIN_API_KEY=
PAYSTACK_SECRET_KEY=
PAID_ENTRY_TESTERS=
SPONSOR_FEE_PCT=15
RESEND_API_KEY=
MAIL_FROM=StepPool <onboarding@resend.dev>
MAIL_USER=
MAIL_APP_PASSWORD=
APPLE_AUDIENCES=com.steppool.app
APPLE_TEAM_ID=
ADMIN_EMAILS=
GOOGLE_CLIENT_IDS=
ANDROID_SHA256_FINGERPRINTS=
REVIEW_EMAIL=
REVIEW_CODE=
