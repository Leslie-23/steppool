{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "components/CoachChatButton.js",
    "components/SectionCard.js",
    "app/(tabs)/workouts.js",
    "app/(tabs)/progress.js",
    "app/(tabs)/profile.js",
    "app/(tabs)/nutrition.js"
  ]
}
